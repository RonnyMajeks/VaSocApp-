@page
@model VaSocApp_System.Pages.Chairperson.AnnouncementsModel
@{
    Layout = "_ChairpersonLayout";
    ViewData["Title"] = "Announcements";
}

<!-- THIS IS THE NEW HEADER WITH THE BUTTON -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">Announcements for @Model.SocietyName</h4>
    <a asp-page="/Chairperson/CreateAnnouncement" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Post Announcement
    </a>
</div>

@if (!Model.AnnouncementsList.Any())
{
    <div class="alert alert-info">No announcements have been posted yet.</div>
}
else
{
    <div class="row">
        @foreach (var item in Model.AnnouncementsList)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                        <strong>@item.Title</strong>
                        <small>@item.DatePosted.ToString("dd MMM yyyy")</small>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@item.Message</p>
                    </div>
                </div>
            </div>
        }
    </div>
}