@page
@model VaSocApp_System.Pages.Chairperson.ChairpersonDashboardModel
@{
    Layout = "_ChairpersonLayout";
    ViewData["Title"] = "Chairperson Dashboard";
}

<div class="alert alert-primary text-center py-4 mt-3" style="background-color: #1a5fa8; color: white; border-radius: 8px;">
    <h3 class="mb-0">Welcome, @Model.FullName!</h3>
    @if (!string.IsNullOrEmpty(Model.SocietyName))
    {
        <p class="mb-0 mt-2">Chairperson of: <strong>@Model.SocietyName</strong></p>
    }
</div>

<div class="card mt-4" style="border-left: 4px solid #1a5fa8;">
    <div class="card-body">
        <h4 class="card-title" style="color: #1a5fa8;">
            <i class="bi bi-mortarboard-fill"></i> Chairperson Dashboard
        </h4>
        <p class="text-muted">Oversee your society's operations and review reports from your team.</p>

        <div class="row mt-4">
            <!-- View Reports -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Chairperson/Reports" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-file-earmark-bar-graph-fill" style="font-size: 50px; color: #0d6efd;"></i>
                        <h6 class="mt-3 fw-bold">View Reports</h6>
                        <p class="text-muted small mb-0">Review reports from Secretary and Treasurer.</p>
                    </div>
                </a>
            </div>

            <!-- Meetings -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Chairperson/Meetings" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-calendar-check-fill" style="font-size: 50px; color: #198754;"></i>
                        <h6 class="mt-3 fw-bold">Meetings</h6>
                        <p class="text-muted small mb-0">Schedule meetings and review minutes.</p>
                    </div>
                </a>
            </div>

            <!-- Memberships -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Chairperson/Memberships" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-people-fill" style="font-size: 50px; color: #6f42c1;"></i>
                        <h6 class="mt-3 fw-bold">Memberships</h6>
                        <p class="text-muted small mb-0">View and manage society members.</p>
                    </div>
                </a>
            </div>

            <!-- Events -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Chairperson/Events" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-calendar2-event-fill" style="font-size: 50px; color: #0dcaf0;"></i>
                        <h6 class="mt-3 fw-bold">Events</h6>
                        <p class="text-muted small mb-0">Oversee society events and activities.</p>
                    </div>
                </a>
            </div>

            <!-- Announcements -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Chairperson/Announcements" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-megaphone-fill" style="font-size: 50px; color: #dc3545;"></i>
                        <h6 class="mt-3 fw-bold">Announcements</h6>
                        <p class="text-muted small mb-0">Post important announcements.</p>
                    </div>
                </a>
            </div>

            <!-- Analytics -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Chairperson/Analytics" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-graph-up-arrow" style="font-size: 50px; color: #6610f2;"></i>
                        <h6 class="mt-3 fw-bold">Analytics</h6>
                        <p class="text-muted small mb-0">View society performance metrics.</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>