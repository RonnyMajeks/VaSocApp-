@page
@model VaSocApp_System.Pages.Chairperson.MeetingsModel
@{
    Layout = "_ChairpersonLayout";
    ViewData["Title"] = "Meetings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-calendar-check" style="color: #1a5fa8;"></i> Meetings for @Model.SocietyName</h4>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#scheduleMeetingModal">
        <i class="bi bi-plus-circle"></i> Schedule Meeting
    </button>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.MeetingsList.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x" style="font-size: 60px; color: #dee2e6;"></i>
            <h5 class="mt-3 text-muted">No Meetings Scheduled</h5>
            <p class="text-muted">Click the "Schedule Meeting" button to create your first meeting.</p>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var meeting in Model.MeetingsList)
        {
            <div class="col-md-6 mb-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0" style="color: #1a5fa8;">@meeting.Title</h5>
                        </div>

                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-calendar3 me-2 text-primary"></i>
                                <span class="fw-bold">@(meeting.Schedule?.ToString("dd MMM yyyy") ?? "TBD")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(meeting.MeetingTime))
                            {
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-clock me-2 text-primary"></i>
                                    <span>@meeting.MeetingTime</span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(meeting.Description))
                        {
                            <div class="mb-3">
                                <h6 class="fw-bold mb-2">Description / Agenda:</h6>
                                <p class="text-muted small mb-0" style="white-space: pre-line;">@meeting.Description</p>
                            </div>
                        }

                        <div class="border-top pt-2 mt-3 d-flex justify-content-between">
                            <small class="text-muted">
                                <i class="bi bi-person"></i> Scheduled by: Chairperson
                            </small>
                            @if (meeting.Secretary?.Person != null)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-person-lines-fill"></i> Secretary: @meeting.Secretary.Person.FirstName @meeting.Secretary.Person.LastName
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Schedule Meeting Modal -->
<div class="modal fade" id="scheduleMeetingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #1a5fa8; color: white;">
                <h5 class="modal-title"><i class="bi bi-calendar-plus"></i> Schedule New Meeting</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="ScheduleMeeting">
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold">Meeting Title *</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g., Branch General Meeting" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Schedule" class="form-label fw-bold">Date *</label>
                            <input asp-for="Schedule" type="date" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MeetingTime" class="form-label fw-bold">Time</label>
                            <input asp-for="MeetingTime" type="time" class="form-control" placeholder="e.g., 14:00" />
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold">Description / Agenda</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter meeting agenda points and details..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Schedule Meeting
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>