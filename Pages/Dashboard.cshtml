@page
@model VaSocApp_System.Pages.DashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
}

<h5>Varsity Society Activities</h5>

<div class="alert alert-primary text-center py-4 mt-3" style="background-color: #1a5fa8; color: white; border-radius: 8px;">
    <h3 class="mb-0">Welcome, @Model.FullName!</h3>
</div>

<div class="card mt-4" style="border-left: 4px solid #1a5fa8;">
    <div class="card-body">
        <h4 class="card-title" style="color: #1a5fa8;">
            🎓 Student Dashboard
        </h4>
        <p class="text-muted">Welcome to university life! Here is how you can get involved:</p>

        <div class="row mt-4">
            <div class="col-md-4 mb-3">
                <a asp-page="/Societies" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4" style="border: 1px solid #e0e0e0; cursor: pointer;">
                        <div style="font-size: 40px;">🔍</div>
                        <h6 class="mt-2">Discover Societies</h6>
                        <p class="text-muted small mb-0">Browse all available societies on your campus.</p>
                    </div>
                </a>
            </div>

            <div class="col-md-4 mb-3">
                <a asp-page="/MySocieties" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4" style="border: 1px solid #e0e0e0; cursor: pointer;">
                        <div style="font-size: 40px;"></div>
                        <h6 class="mt-2">My Societies</h6>
                        <p class="text-muted small mb-0">View and manage your society memberships.</p>
                    </div>
                </a>
            </div>

            <div class="col-md-4 mb-3">
                <a asp-page="/Events" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4" style="border: 1px solid #e0e0e0; cursor: pointer;">
                        <div style="font-size: 40px;"></div>
                        <h6 class="mt-2">Events</h6>
                        <p class="text-muted small mb-0">Never miss a meeting or gathering.</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>