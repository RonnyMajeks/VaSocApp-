@page
@model VaSocApp_System.Pages.ForgotPasswordModel
@{
    Layout = null; ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
            body {
                background: linear-gradient(135deg, #2c4a52 0%, #1a3a4a 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
            }

            .card {
                background: white;
                border-radius: 12px;
                padding: 40px;
                max-width: 400px;
                width: 100%;
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
                text-align: center;
            }

            .logo-box {
                width: 50px;
                height: 50px;
                background-color: #8a1a2a;
                border-radius: 10px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 24px;
                font-weight: bold;
                margin-bottom: 15px;
            }

            .btn-primary {
                background-color: #8a1a2a;
                border: none;
                padding: 12px;
                width: 100%;
                font-weight: 600;
                border-radius: 6px;
            }

                .btn-primary:hover {
                    background-color: #6d1422;
                }

            .form-control {
                border-radius: 6px;
                padding: 12px;
            }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo-box">V</div>
        <h4 class="mb-2">Forgot Password?</h4>
        <p class="text-muted small mb-4">Enter your username or email to receive a reset code.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger p-2 small">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success p-2 small">@Model.SuccessMessage</div>
        }

        <form method="post">
            <input asp-for="Username" class="form-control mb-3" placeholder="Username or Student Number" required />
            <button type="submit" class="btn btn-primary">Send Reset Code</button>
        </form>
        <div class="mt-3"><a asp-page="/Login" class="text-decoration-none" style="color: #8a1a2a; font-size: 14px;">← Back to Login</a></div>
    </div>
</body>
</html>