@page
@model VaSocApp_System.Pages.MyProfileModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    <div class="row">
        <!-- Profile Header -->
        <div class="col-12 mb-4">
            <div class="d-flex justify-content-between align-items-center">
                <h2 class="text-primary"><i class="bi bi-person-circle"></i> My Profile</h2>
                <!-- THIS IS THE BUTTON YOU WERE LOOKING FOR -->
                <a asp-page="/EditProfile" class="btn btn-primary">
                    <i class="bi bi-pencil-square"></i> Edit Profile
                </a>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="col-12">
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            </div>
        }

        @if (Model.StudentRecord != null && Model.PersonRecord != null)
        {
            <!-- Personal Information Card -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-header bg-white border-bottom-0 pt-4 ps-4">
                        <h5 class="card-title text-primary fw-bold">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-person me-2"></i> Full Name</span>
                                <span class="fw-bold">@Model.PersonRecord.FirstName @Model.PersonRecord.LastName</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-credit-card me-2"></i> Student Number</span>
                                <span class="fw-bold">@Model.StudentRecord.StudentNumber</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-envelope me-2"></i> Email</span>
                                <span>@Model.PersonRecord.Email</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-telephone me-2"></i> Phone</span>
                                <span>@(Model.PersonRecord.Phone ?? "Not provided")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-people me-2"></i> Culture</span>
                                <span>@(Model.StudentRecord.CidNavigation != null ? Model.StudentRecord.CidNavigation.CultureName : "N/A")</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Academic Details Card -->
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 border-0">
                    <div class="card-header bg-white border-bottom-0 pt-4 ps-4">
                        <h5 class="card-title text-success fw-bold">Academic Details</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-building me-2"></i> Faculty</span>
                                <span>@(Model.StudentRecord.Faculty != null ? Model.StudentRecord.Faculty.FacultyName : "Not assigned")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-geo-alt me-2"></i> Campus</span>
                                <span>@(Model.StudentRecord.Campus != null ? Model.StudentRecord.Campus.CampusName : "Not assigned")</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <span class="text-muted"><i class="bi bi-calendar-check me-2"></i> Year of Study</span>
                                <span>Year @(Model.StudentRecord.YearOfStudy)</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning">Profile data could not be loaded.</div>
            </div>
        }
    </div>
</div>