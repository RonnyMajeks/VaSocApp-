@page
@model VaSocApp_System.Pages.MySocietiesModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Societies";
}

<h4>My Societies</h4>

@if (!Model.MyMemberships.Any())
{
    <div class="alert alert-info">
        You haven't joined any societies yet. Go to <a asp-page="/Societies">Browse Societies</a> to request to join one!
    </div>
}
else
{
    <div class="row">
        @foreach (var membership in Model.MyMemberships)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-success">
                    <div class="card-header bg-success text-white">
                        <h6 class="mb-0">✓ Active Member</h6>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title text-primary">@membership.Society?.SocietyName</h5>
                        <p class="card-text text-muted">@membership.Society?.Description</p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <button class="btn btn-outline-success w-100" disabled>Joined</button>
                    </div>
                </div>
            </div>
        }
    </div>
}