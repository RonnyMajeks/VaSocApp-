@page
@model VaSocApp_System.Pages.ResetPasswordModel
@{
    Layout = null; ViewData["Title"] = "Reset Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
            body {
                background: linear-gradient(135deg, #2c4a52 0%, #1a3a4a 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
            }

            .card {
                background: white;
                border-radius: 12px;
                padding: 40px;
                max-width: 400px;
                width: 100%;
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
                text-align: center;
            }

            .btn-primary {
                background-color: #8a1a2a;
                border: none;
                padding: 12px;
                width: 100%;
                font-weight: 600;
                border-radius: 6px;
            }

                .btn-primary:hover {
                    background-color: #6d1422;
                }

            .form-control {
                border-radius: 6px;
                padding: 12px;
            }
    </style>
</head>
<body>
    <div class="card">
        <h4 class="mb-2">Set New Password</h4>
        <p class="text-muted small mb-4">Create a strong new password for your account.</p>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger p-2 small">@Model.ErrorMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success p-2 small">@Model.SuccessMessage</div>
        }

        <form method="post">
            <input asp-for="NewPassword" type="password" class="form-control mb-3" placeholder="New Password" required minlength="6" />
            <input asp-for="ConfirmPassword" type="password" class="form-control mb-3" placeholder="Confirm New Password" required minlength="6" />
            <button type="submit" class="btn btn-primary">Reset Password</button>
        </form>
    </div>
</body>
</html>