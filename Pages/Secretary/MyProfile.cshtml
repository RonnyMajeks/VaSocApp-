@page
@model VaSocApp_System.Pages.Secretary.MyProfileModel
@{
    Layout = "_SecretaryLayout";
    ViewData["Title"] = "My Profile";
}

<h4>My Profile</h4>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else if (Model.PersonRecord != null)
{
    <div class="row">
        <!-- Personal Info Card -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Personal Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th style="width: 30%;">Full Name</th>
                            <td>@Model.PersonRecord.FirstName @Model.PersonRecord.LastName</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.PersonRecord.Email</td>
                        </tr>
                        <tr>
                            <th>Phone</th>
                            <td>@(Model.PersonRecord.Phone ?? "Not provided")</td>
                        </tr>
                        <tr>
                            <th>Username</th>
                            <td>@Model.PersonRecord.Username</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Role Info Card -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Role Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th>Position</th>
                            <td><span class="badge bg-primary">Secretary</span></td>
                        </tr>
                        <tr>
                            <th>Society</th>
                            <td>@(Model.SocietyName ?? "Not assigned")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Button -->
    <a asp-page="/Secretary/EditProfile" class="btn btn-primary">
        ✏️ Edit Profile
    </a>
}