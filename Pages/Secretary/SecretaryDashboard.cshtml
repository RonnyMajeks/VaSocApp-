@page
@model VaSocApp_System.Pages.Secretary.SecretaryDashboardModel
@{
    Layout = "_SecretaryLayout";
    ViewData["Title"] = "Secretary Dashboard";
}

<!-- Welcome Banner -->
<div class="alert alert-primary text-center py-4 mt-3" style="background-color: #1a5fa8; color: white; border-radius: 8px;">
    <h3 class="mb-0">Welcome, @Model.FullName!</h3>
    @if (!string.IsNullOrEmpty(Model.SocietyName))
    {
        <p class="mb-0 mt-2">Secretary of: <strong>@Model.SocietyName</strong></p>
    }
</div>

<!-- Society Leader Dashboard Card -->
<div class="card mt-4" style="border-left: 4px solid #1a5fa8;">
    <div class="card-body">
        <h4 class="card-title" style="color: #1a5fa8;">
            <i class="bi bi-mortarboard-fill"></i> Society Leader Dashboard
        </h4>
        <p class="text-muted">As a Leader, you are the backbone of your society. Here is what you can do:</p>

        <div class="row mt-4">
            <!-- Manage Members -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Secretary/Memberships" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-people-fill" style="font-size: 50px; color: #0d6efd;"></i>
                        <h6 class="mt-3 fw-bold">Manage Members</h6>
                        <p class="text-muted small mb-0">Track your society members and update statuses.</p>
                    </div>
                </a>
            </div>

            <!-- Host Events -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Secretary/Events" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-calendar-event-fill" style="font-size: 50px; color: #198754;"></i>
                        <h6 class="mt-3 fw-bold">Host Events</h6>
                        <p class="text-muted small mb-0">Create meetings, workshops, and socials.</p>
                    </div>
                </a>
            </div>

            <!-- Post Announcements -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Secretary/Announcements" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-megaphone-fill" style="font-size: 50px; color: #dc3545;"></i>
                        <h6 class="mt-3 fw-bold">Post Announcements</h6>
                        <p class="text-muted small mb-0">Keep your members informed with instant updates.</p>
                    </div>
                </a>
            </div>

            <!-- Membership Requests -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Secretary/Requests" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-clipboard-check-fill" style="font-size: 50px; color: #6f42c1;"></i>
                        <h6 class="mt-3 fw-bold">Membership Requests</h6>
                        <p class="text-muted small mb-0">Approve or decline new student requests.</p>
                    </div>
                </a>
            </div>

            <!-- Schedule Meetings -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Secretary/Meetings" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-clock-history" style="font-size: 50px; color: #0dcaf0;"></i>
                        <h6 class="mt-3 fw-bold">Schedule Meetings</h6>
                        <p class="text-muted small mb-0">Organize and manage society gatherings.</p>
                    </div>
                </a>
            </div>

            <!-- Records & Analytics -->
            <div class="col-md-4 mb-3">
                <a asp-page="/Secretary/Records" class="text-decoration-none text-dark">
                    <div class="card h-100 text-center p-4 border" style="cursor: pointer; transition: transform 0.2s;">
                        <i class="bi bi-bar-chart-line-fill" style="font-size: 50px; color: #6610f2;"></i>
                        <h6 class="mt-3 fw-bold">Records & Analytics</h6>
                        <p class="text-muted small mb-0">View reports and submit to Chairperson.</p>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>