@page
@model VaSocApp_System.Pages.SocietiesModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Societies";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Step 1: Browse Societies at @Model.CampusName</h4>
</div>

@if (Model.SocietiesList == null || !Model.SocietiesList.Any())
{
    <div class="alert alert-info">There are no societies available for your campus yet.</div>
}
else
{
    <div class="row">
        @foreach (var item in Model.SocietiesList)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@item.SocietyName</h5>
                        <p class="card-text text-muted">@item.Description</p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <!-- Link to Step 2: View Details -->
                        <a asp-page="/SocietyDetails" asp-route-id="@item.SocietyId" class="btn btn-primary w-100">
                            View Details & Request
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}