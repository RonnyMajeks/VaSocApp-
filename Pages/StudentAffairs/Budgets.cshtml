@page
@model VaSocApp_System.Pages.StudentAffairs.BudgetsModel
@{
    Layout = "_StudentAffairsLayout";
    ViewData["Title"] = "Budgets";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-cash-stack" style="color: #6f42c1;"></i> Budget Management</h4>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-4">
    <!-- Total Allocated Summary Card -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 border-start border-4" style="border-color: #6f42c1 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1">Total Allocated Budget</h6>
                        <h2 class="mb-0 fw-bold" style="color: #6f42c1;">R @Model.TotalAllocated.ToString("N2")</h2>
                    </div>
                    <i class="bi bi-wallet2" style="font-size: 2.5rem; color: #6f42c1;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Allocate Budget Form -->
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold" style="color: #6f42c1;"><i class="bi bi-plus-circle"></i> Allocate Budget to Society</h6>
            </div>
            <div class="card-body">
                <form method="post" class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label asp-for="SocietyId" class="form-label small fw-bold">Select Society *</label>
                        <select asp-for="SocietyId" asp-items="@(new SelectList(Model.SocietiesList, "SocietyId", "SocietyName"))" class="form-select" required>
                            <option value="">-- Select Society --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AcademicYear" class="form-label small fw-bold">Academic Year *</label>
                        <input asp-for="AcademicYear" class="form-control" placeholder="e.g., 2026" required />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AmountAllocated" class="form-label small fw-bold">Amount (R) *</label>
                        <input asp-for="AmountAllocated" class="form-control" type="number" step="0.01" placeholder="0.00" required />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn text-white w-100" style="background-color: #6f42c1;">
                            <i class="bi bi-check-lg"></i> Allocate
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Budget Allocation History Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white">
        <h5 class="mb-0" style="color: #6f42c1;"><i class="bi bi-table"></i> Budget Allocation History</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.BudgetsList.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">No budget allocations recorded yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Society</th>
                            <th>Academic Year</th>
                            <th>Amount Allocated</th>
                            <th>Date Allocated</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.BudgetsList)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@b.Society?.SocietyName</td>
                                <td><span class="badge bg-light text-dark border">@b.AcademicYear</span></td>
                                <td class="fw-bold" style="color: #198754;">R @((b.AmountAllocated ?? 0).ToString("N2"))</td>
                                <td class="text-muted small">@(b.DateAllocated?.ToString("dd MMM yyyy") ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>