@page
@model VaSocApp_System.Pages.StudentAffairs.MyProfileModel
@{
    Layout = "_StudentAffairsLayout";
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0"><i class="bi bi-person-badge" style="color: #6f42c1;"></i> My Profile</h4>
    @if (!Model.IsEditMode)
    {
        <a asp-page="/StudentAffairs/MyProfile" asp-route-edit="true" class="btn text-white" style="background-color: #6f42c1;">
            <i class="bi bi-pencil-square"></i> Edit Profile
        </a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.PersonRecord != null)
{
    <div class="row">
        <!-- Personal Information Card -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white" style="background: linear-gradient(135deg, #6f42c1 0%, #4e2a84 100%);">
                    <h5 class="mb-0"><i class="bi bi-person"></i> Personal Information</h5>
                </div>
                <div class="card-body">
                    @if (Model.IsEditMode)
                    {
                        <form method="post">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                                    <input asp-for="FirstName" class="form-control" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                                    <input asp-for="LastName" class="form-control" required />
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                                    <input asp-for="Email" class="form-control" type="email" required />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Phone" class="form-label fw-bold">Phone</label>
                                    <input asp-for="Phone" class="form-control" />
                                </div>
                            </div>
                            <div class="mb-3">
                                <label asp-for="Username" class="form-label fw-bold">Username</label>
                                <input asp-for="Username" class="form-control" required />
                            </div>
                            <button type="submit" class="btn text-white" style="background-color: #6f42c1;">
                                <i class="bi bi-check-lg"></i> Save Changes
                            </button>
                            <a asp-page="/StudentAffairs/MyProfile" class="btn btn-secondary ms-2">Cancel</a>
                        </form>
                    }
                    else
                    {
                        <table class="table table-borderless mb-0">
                            <tr>
                                <th style="width: 30%;">Full Name</th>
                                <td>@Model.PersonRecord.FirstName @Model.PersonRecord.LastName</td>
                            </tr>
                            <tr>
                                <th>Email</th>
                                <td>@Model.PersonRecord.Email</td>
                            </tr>
                            <tr>
                                <th>Phone</th>
                                <td>@(Model.PersonRecord.Phone ?? "Not provided")</td>
                            </tr>
                            <tr>
                                <th>Username</th>
                                <td>@Model.PersonRecord.Username</td>
                            </tr>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- Role Details Card -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header text-white bg-success">
                    <h5 class="mb-0"><i class="bi bi-shield-check"></i> Role Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th style="width: 40%;">Position</th>
                            <td><span class="badge text-white" style="background-color: #6f42c1;">Student Affairs Officer</span></td>
                        </tr>
                        <tr>
                            <th>Access Level</th>
                            <td><span class="badge bg-info text-dark">University Admin</span></td>
                        </tr>
                        <tr>
                            <th>Status</th>
                            <td>
                                @if (Model.PersonRecord.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Inactive</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">Profile data could not be loaded.</div>
}