@page
@model VaSocApp_System.Pages.StudentAffairs.StudentAffairsDashboardModel
@{
    Layout = "_StudentAffairsLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="hero-banner mb-4" style="
    background: linear-gradient(135deg, rgba(111, 66, 193, 0.95) 0%, rgba(78, 42, 132, 0.95) 100%),
    url('https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=1600&q=80') center/cover;
    color: white; padding: 40px; border-radius: 12px; position: relative; overflow: hidden;">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h2 class="mb-2 fw-bold">Welcome, @Model.FullName!</h2>
            <p class="mb-0 opacity-75">University Management Portal • @(ViewData["CampusName"] ?? "Campus")</p>
        </div>
        <div class="col-md-4 text-end d-none d-md-block">
            <i class="bi bi-mortarboard-fill" style="font-size: 80px; opacity: 0.3;"></i>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #6f42c1 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Total Societies</h6>
                        <h2 class="mb-0 fw-bold" style="color: #6f42c1;">@Model.TotalSocieties</h2>
                    </div>
                    <i class="bi bi-people-fill" style="font-size: 40px; color: #6f42c1; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Active Members</h6>
                        <h2 class="mb-0 fw-bold text-success">@Model.ActiveMembers.ToString("N0")</h2>
                    </div>
                    <i class="bi bi-person-check-fill" style="font-size: 40px; color: #198754; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Total Budget</h6>
                        <h2 class="mb-0 fw-bold text-primary">R @Model.TotalBudget.ToString("N0")</h2>
                    </div>
                    <i class="bi bi-cash-stack" style="font-size: 40px; color: #0d6efd; opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 small text-uppercase">Pending Requests</h6>
                        <h2 class="mb-0 fw-bold" style="color: #b38600;">@Model.PendingRequests</h2>
                    </div>
                    <i class="bi bi-hourglass-split" style="font-size: 40px; color: #ffc107; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0 fw-bold" style="color: #6f42c1;">
                    <i class="bi bi-lightning-charge-fill"></i> Quick Actions
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <a asp-page="/StudentAffairs/Societies" class="text-decoration-none">
                            <div class="card h-100 text-center p-3 border-0" style="background-color: #f8f9fa; transition: transform 0.2s;">
                                <i class="bi bi-plus-circle-fill" style="font-size: 32px; color: #6f42c1;"></i>
                                <h6 class="mt-2 mb-0 fw-bold">Register Society</h6>
                                <small class="text-muted">Add new society</small>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-page="/StudentAffairs/Budgets" class="text-decoration-none">
                            <div class="card h-100 text-center p-3 border-0" style="background-color: #f8f9fa; transition: transform 0.2s;">
                                <i class="bi bi-cash-coin" style="font-size: 32px; color: #198754;"></i>
                                <h6 class="mt-2 mb-0 fw-bold">Allocate Budget</h6>
                                <small class="text-muted">Manage funds</small>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a asp-page="/StudentAffairs/Announcements" class="text-decoration-none">
                            <div class="card h-100 text-center p-3 border-0" style="background-color: #f8f9fa; transition: transform 0.2s;">
                                <i class="bi bi-megaphone-fill" style="font-size: 32px; color: #0d6efd;"></i>
                                <h6 class="mt-2 mb-0 fw-bold">Announcement</h6>
                                <small class="text-muted">Send updates</small>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold" style="color: #6f42c1;">
                    <i class="bi bi-clock-history"></i> Recent Campus Notices
                </h5>
                <a asp-page="/StudentAffairs/Announcements" class="small text-decoration-none">View All</a>
            </div>
            <div class="card-body p-0">
                @if (!Model.RecentAnnouncements.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-inbox text-muted" style="font-size: 40px;"></i>
                        <p class="text-muted small mt-2 mb-0">No campus notices yet</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.RecentAnnouncements)
                        {
                            <div class="list-group-item border-0 px-3 py-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-1 small fw-bold">@item.Title.Replace("[CAMPUS NOTICE] ", "")</h6>
                                        <p class="mb-1 small text-muted" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 250px;">@item.Message</p>
                                        <small class="text-muted" style="font-size: 11px;">
                                            <i class="bi bi-clock"></i> @item.DatePosted.ToString("dd MMM yyyy")
                                        </small>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>