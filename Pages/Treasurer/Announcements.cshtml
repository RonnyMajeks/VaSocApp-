@page
@model VaSocApp_System.Pages.Treasurer.AnnouncementsModel
@{
    Layout = "_TreasurerLayout";
    ViewData["Title"] = "Announcements";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Announcements: @Model.SocietyName</h4>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Post New Announcement Form -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <h5 class="card-title text-primary mb-3"><i class="bi bi-megaphone"></i> Post New</h5>
                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Title</label>
                        <input asp-for="Title" class="form-control" placeholder="e.g., Meeting Reminder" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Message" class="form-label fw-bold">Message</label>
                        <textarea asp-for="Message" class="form-control" rows="4" placeholder="Enter details..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Post Announcement</button>
                </form>
            </div>
        </div>
    </div>

    <!-- Announcements List -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0 text-primary"><i class="bi bi-list-ul"></i> Recent Announcements</h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.AnnouncementsList.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-chat-square-text text-muted" style="font-size: 3rem;"></i>
                        <p class="text-muted mt-2">No announcements posted yet.</p>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.AnnouncementsList)
                        {
                            <div class="list-group-item p-4">
                                <div class="d-flex w-100 justify-content-between mb-2">
                                    <h6 class="mb-1 fw-bold text-primary">@item.Title</h6>
                                    <small class="text-muted">@item.DatePosted.ToString("dd MMM yyyy")</small>
                                </div>
                                <p class="mb-1 text-dark">@item.Message</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>