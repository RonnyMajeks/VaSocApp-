@page
@model VaSocApp_System.Pages.Treasurer.EditProfileModel
@{
    Layout = "_TreasurerLayout";
    ViewData["Title"] = "Update Profile";
}

<h4>Update Profile</h4>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <form method="post">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                    <input asp-for="FirstName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                    <input asp-for="LastName" class="form-control" required />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    <input asp-for="Email" class="form-control" type="email" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-bold">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label fw-bold">Username</label>
                    <input asp-for="Username" class="form-control" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-page="/Treasurer/MyProfile" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>