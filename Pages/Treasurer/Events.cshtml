@page
@model VaSocApp_System.Pages.Treasurer.EventsModel
@{
    Layout = "_TreasurerLayout";
    ViewData["Title"] = "Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Events Calendar: @Model.SocietyName</h4>
    <span class="badge bg-secondary fs-6">Total: @Model.EventsList.Count</span>
</div>

@if (!Model.EventsList.Any())
{
    <div class="card shadow-sm text-center py-5">
        <div class="card-body">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            <h5 class="mt-3 text-muted">No events scheduled yet.</h5>
            <p class="text-muted">Check back later for society events and meetings.</p>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var ev in Model.EventsList)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100 border-0 border-start border-info border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title text-primary fw-bold mb-0">@ev.Title</h5>
                            <span class="badge bg-light text-info border">
                                @ev.EventDate.ToString("dd MMM yyyy")
                            </span>
                        </div>

                        @if (ev.EventTime.HasValue)
                        {
                            <p class="text-muted small mb-2"><i class="bi bi-clock"></i> @ev.EventTime.Value.ToString("HH:mm")</p>
                        }

                        <p class="card-text text-dark">@ev.Description</p>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            @if (!string.IsNullOrEmpty(ev.Venue))
                            {
                                <p class="mb-0 small text-muted">
                                    <i class="bi bi-geo-alt-fill text-danger"></i> <strong>Venue:</strong> @ev.Venue
                                </p>
                            }

                            @if (ev.IsMembersOnly)
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-lock-fill"></i> Members Only</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}