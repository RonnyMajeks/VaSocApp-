@page
@model VaSocApp_System.Pages.Treasurer.ExpensesModel
@{
    Layout = "_TreasurerLayout";
    ViewData["Title"] = "Expenses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4>Expenses Tracker: @Model.SocietyName</h4>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Total Expenses Summary Card -->
<div class="card shadow-sm border-0 border-start border-danger border-4 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h6 class="text-muted mb-1">Total Money Spent</h6>
                <h2 class="mb-0 fw-bold text-danger">R @Model.TotalExpenses.ToString("N2")</h2>
            </div>
            <i class="bi bi-cash-stack text-danger" style="font-size: 3rem;"></i>
        </div>
    </div>
</div>

<!-- Add New Expense Form -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0 text-primary"><i class="bi bi-plus-circle"></i> Record New Expense</h5>
    </div>
    <div class="card-body">
        <form method="post" class="row g-3">
            <div class="col-md-6">
                <label asp-for="Description" class="form-label fw-bold">What was the money used for?</label>
                <input asp-for="Description" class="form-control" placeholder="e.g., Bought printing paper for AGM" required />
            </div>
            <div class="col-md-4">
                <label asp-for="Amount" class="form-label fw-bold">Amount (R)</label>
                <input asp-for="Amount" class="form-control" type="number" step="0.01" placeholder="0.00" required />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-danger w-100">Record</button>
            </div>
        </form>
    </div>
</div>

<!-- Expenses List Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0 text-primary"><i class="bi bi-list-ul"></i> Expense History</h5>
    </div>
    <div class="card-body p-0">
        @if (!Model.ExpenseList.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-receipt text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">No expenses recorded yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date Recorded</th>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var expense in Model.ExpenseList)
                        {
                            <tr>
                                <td class="text-muted">@(expense.DateRecorded?.ToString("dd MMM yyyy") ?? "N/A")</td>
                                <td>@expense.Description</td>
                                <td class="text-end text-danger fw-bold">- R @((expense.Amount ?? 0).ToString("N2"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>