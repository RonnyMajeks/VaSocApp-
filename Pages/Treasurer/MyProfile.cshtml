@page
@model VaSocApp_System.Pages.Treasurer.MyProfileModel
@{
    Layout = "_TreasurerLayout";
    ViewData["Title"] = "My Profile";
}

<h4 class="mb-4">My Profile</h4>

@if (Model.PersonRecord != null)
{
    <div class="row">
        <!-- Personal Information Card (Left Side) -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Personal Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th style="width: 30%;">Full Name</th>
                            <td>@Model.PersonRecord.FirstName @Model.PersonRecord.LastName</td>
                        </tr>
                        <tr>
                            <th>Email</th>
                            <td>@Model.PersonRecord.Email</td>
                        </tr>
                        <tr>
                            <th>Phone</th>
                            <td>@(Model.PersonRecord.Phone ?? "Not provided")</td>
                        </tr>
                        <tr>
                            <th>Username</th>
                            <td>@Model.PersonRecord.Username</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Role Details Card (Right Side) -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Role Details</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th style="width: 40%;">Position</th>
                            <td><span class="badge bg-primary">Treasurer</span></td>
                        </tr>
                        <tr>
                            <th>Society</th>
                            <td>@(Model.SocietyName ?? "Not assigned")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Button at the bottom -->
    <a asp-page="/Treasurer/EditProfile" class="btn btn-primary">
        <i class="bi bi-pencil-square"></i> Edit Profile
    </a>
}
else
{
    <div class="alert alert-warning">Profile data could not be loaded.</div>
}