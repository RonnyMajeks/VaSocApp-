@page
@model VaSocApp_System.Pages.VerifyOtpModel
@{
    Layout = null; ViewData["Title"] = "Verify OTP";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
            body {
                background: linear-gradient(135deg, #2c4a52 0%, #1a3a4a 100%);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
            }

            .card {
                background: white;
                border-radius: 12px;
                padding: 40px;
                max-width: 400px;
                width: 100%;
                box-shadow: 0 10px 30px rgba(0,0,0,0.3);
                text-align: center;
            }

            .btn-primary {
                background-color: #8a1a2a;
                border: none;
                padding: 12px;
                width: 100%;
                font-weight: 600;
                border-radius: 6px;
            }

                .btn-primary:hover {
                    background-color: #6d1422;
                }

            .otp-input {
                font-size: 24px;
                text-align: center;
                letter-spacing: 10px;
                font-weight: bold;
                border-radius: 6px;
                padding: 15px;
            }

            .otp-display {
                background-color: #d1e7dd;
                color: #0f5132;
                border: 1px solid #badbcc;
                border-radius: 6px;
                padding: 15px;
                margin-bottom: 20px;
            }

            .otp-code {
                font-size: 28px;
                font-weight: bold;
                letter-spacing: 5px;
                color: #0f5132;
            }
    </style>
</head>
<body>
    <div class="card">
        <h4 class="mb-2">Enter Reset Code</h4>
        <p class="text-muted small mb-4">We sent a 6-digit code to your account.</p>

        @if (!string.IsNullOrEmpty(Model.TestOtpCode))
        {
            <div class="otp-display">
                <small class="d-block mb-1">For testing purposes, your code is:</small>
                <div class="otp-code">@Model.TestOtpCode</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger p-2 small">@Model.ErrorMessage</div>
        }

        <form method="post">
            <input asp-for="OtpCode" class="form-control otp-input mb-3" maxlength="6" placeholder="000000" required />
            <button type="submit" class="btn btn-primary">Verify Code</button>
        </form>
    </div>
</body>
</html>